# ==============================================================================
# CivicHelix Platform - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Multimodal Vision Engine (Google Gemini Vision for Document & Stamp Paper OCR)
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Supabase Cloud Database & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostgreSQL Direct Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@your-project.supabase.co:5432/postgres?sslmode=require"

# Authentication & Session Security
NEXTAUTH_SECRET="civic-triple-helix-secret-jwt-key-2026-production"
NEXTAUTH_URL="http://localhost:3000"
