# ==============================================================================
# Civic Problem-Solving & Triple-Helix Platform - Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (with pgvector extension enabled)
# For Supabase / Neon / Local PostgreSQL with pgvector:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/civic_helix_db?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/civic_helix_db?schema=public"

# Authentication & Session Management (NextAuth / JWT / Supabase)
NEXTAUTH_SECRET="super-secret-jwt-signing-key-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI & Embedding Engine
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"
OPENAI_API_KEY="sk-proj-your-openai-api-key"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
AI_CLASSIFICATION_MODEL="gpt-4o-mini"

# Priority Scoring & Deduplication Hyperparameters
SIMILARITY_DUPLICATE_THRESHOLD=0.85
MAX_GEOGRAPHIC_CLUSTER_RADIUS_KM=5.0
SEVERITY_WEIGHT=0.40
IMPACT_WEIGHT=0.25
URGENCY_WEIGHT=0.20
GEOGRAPHIC_WEIGHT=0.15

# Cloud Object Storage (S3 / Cloudflare R2 / Supabase Storage for Audio & Images)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET_NAME="civic-platform-media"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_PUBLIC_BASE_URL="https://cdn.civic-helix.org"

# Government SLA Thresholds (in hours)
SLA_HIGH_SEVERITY_HOURS=48
SLA_MEDIUM_SEVERITY_HOURS=168
SLA_LOW_SEVERITY_HOURS=336
